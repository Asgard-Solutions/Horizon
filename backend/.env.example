# Optional local configuration. Copy to backend/.env and edit. All values are optional.
# Where the SQLite catalog/settings are stored (default: <project>/data)
# MC_DATA_DIR=C:\OpenMediaCenter\data
# Port used by run.py / start.bat (default 8765)
# MC_PORT=8765
# Full path to ffprobe.exe if it is not on PATH and not in <project>\tools\
# MC_FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# DEVELOPMENT ONLY - extra networks treated as the host administrator (e.g. behind a reverse proxy). Leave empty.
# MC_ADMIN_NETWORKS=
# DEVELOPMENT ONLY - extra Host header names accepted for host-admin requests. Leave empty.
# MC_ALLOWED_HOSTS=
